# ---------------------------------------------------------------------------
# The TOOLS (fonts, type scale, colour, identify) need none of this. They run
# and deploy with an empty env file.
#
# The COMMUNITY (post, save, collections, messaging) needs the database and the
# blob store below. Without them those routes render an explanation instead of
# erroring — see src/lib/db.ts.
# ---------------------------------------------------------------------------

# Canonical origin for sitemap.xml, robots.txt and Open Graph metadata.
# Leave unset and it falls back to the deployment URL.
# NEXT_PUBLIC_SITE_URL=https://baseline.example.com

# Raises the GitHub API rate limit during `npm run ingest` (60/hr -> 5,000/hr).
# Only needed when regenerating src/data/fonts.json.
# GITHUB_TOKEN=ghp_xxx


# --- community: required ---------------------------------------------------

# Postgres. On Vercel this is set automatically by the Neon integration.
# Locally: createdb baseline && export DATABASE_URL=...
# DATABASE_URL=postgresql://user:password@host:5432/baseline

# Image uploads. Set automatically by the Vercel Blob store.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Session encryption. Generate with: npx auth secret
# AUTH_SECRET=

# Required in production so Auth.js builds correct callback URLs.
# AUTH_URL=https://baseline-wheat.vercel.app


# --- community: at least one sign-in method --------------------------------

# Google OAuth. Redirect URI: <origin>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Email magic links via Resend.
# AUTH_RESEND_KEY=re_xxx
# AUTH_EMAIL_FROM=Baseline <hello@yourdomain.com>
