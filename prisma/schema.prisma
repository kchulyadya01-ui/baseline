// Baseline — data model.
//
// LIVE for the Community section (accounts, projects, collections, messaging).
// DORMANT for the Kit (Phase 2): those models are written and migrated, but no
// code reads them yet — the studios still keep their state in the URL and in
// component state.
//
// THE RULE for the Kit: it is the aggregate root, and every child carries
// kitId. That single constraint is what makes "change a colour -> revalidate
// every contrast pair" one transactional query instead of cross-service
// orchestration. Do not compromise it.
//
// Setup:
//   1. provision Postgres  (Neon)
//   2. set DATABASE_URL
//   3. npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema; see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// --- accounts ------------------------------------------------------------
// Auth.js (NextAuth v5) owns User, Account, Session and VerificationToken.
// Field names in those four are fixed by the adapter — do not rename them.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Profile. The handle is the public identity: /u/[handle]
  //
  // Nullable because Auth.js inserts the row before the person has chosen one.
  // A null handle means "not onboarded": requireOnboarded() in src/lib/auth.ts
  // redirects to /welcome, and nothing that writes will run without it.
  handle    String?  @unique
  bio       String?  @db.VarChar(280)
  website   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when a moderator suspends the account. Suspended users can read but
  // cannot post, save, follow or message.
  suspendedAt     DateTime?
  suspendedReason String?

  accounts Account[]
  sessions Session[]

  kits          Kit[]
  projects      Project[]
  collections   Collection[]
  likes         Like[]
  saves         Save[]
  following     Follow[]              @relation("follower")
  followers     Follow[]              @relation("following")
  participantIn ConversationMember[]
  messagesSent  Message[]
  blocksMade    Block[]               @relation("blocker")
  blocksAgainst Block[]               @relation("blocked")
  reportsMade   Report[]              @relation("reporter")

  @@index([handle])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- catalogue -----------------------------------------------------------
// Mirrors src/data/fonts.json. Ingestion writes here once the DB is live;
// the JSON snapshot becomes a build-time cache of this table.

model License {
  id                String  @id // "OFL-1.1", "Apache-2.0", "UFL-1.0"
  name              String
  url               String
  redistributable   Boolean @default(true)
  commercialUse     Boolean @default(true)
  embedding         Boolean @default(true)
  modification      Boolean @default(true)
  sellingFontItself Boolean @default(false)

  fonts Font[]

  @@map("licenses")
}

model Font {
  id           String   @id @default(cuid())
  slug         String   @unique
  family       String   @unique
  category     String
  designers    String[]
  subsets      String[]
  weights      Int[]
  hasItalic    Boolean  @default(false)
  isVariable   Boolean  @default(false)
  popularity   Int
  sizeBytes    Int
  dateAdded    DateTime
  lastModified DateTime

  // Provenance. The licence claim has to be traceable to a source, or the
  // ">99% licence accuracy" requirement is just a hope.
  sourceRepo  String @default("github.com/google/fonts")
  sourcePath  String // e.g. "ofl/inter"
  licenseFile String

  // Commercial faces are indexed as metadata + buy link ONLY. There is
  // deliberately no file column on this model: the legal guardrail is in the
  // schema, not in a code path someone can forget.
  isCommercial Boolean @default(false)
  purchaseUrl  String?

  licenseId String
  license   License @relation(fields: [licenseId], references: [id])

  variants FontVariant[]
  kitFonts KitFont[]
  axes     FontAxis[]

  @@index([category, popularity])
  @@index([popularity])
  @@map("fonts")
}

model FontAxis {
  id           String @id @default(cuid())
  tag          String // wght, wdth, opsz, slnt …
  min          Float
  max          Float
  defaultValue Float

  fontId String
  font   Font   @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, tag])
  @@map("font_axes")
}

model FontVariant {
  id       String  @id @default(cuid())
  weight   Int
  style    String  @default("normal") // normal | italic
  fileUrl  String? // our own CDN, OFL only — never set for commercial fonts
  fileSize Int?

  fontId String
  font   Font   @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, weight, style])
  @@map("font_variants")
}

// Phase 3 will add a GlyphEmbedding model here — a 512-dim vector per variant,
// searched with pgvector cosine distance for image-mode identification. It is
// left out until then rather than migrated early: it needs the pgvector
// extension enabled on the database, and nothing should be installed on a
// production instance months before the first query that uses it.

// --- the Kit -------------------------------------------------------------

model Kit {
  id        String   @id @default(cuid())
  name      String
  brief     String?
  slug      String   @unique
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  fonts    KitFont[]
  scales   TypeScale[]
  palettes Palette[]
  boards   Board[]
  versions KitVersion[]
  exports  ExportJob[]

  @@index([ownerId, updatedAt])
  @@map("kits")
}

model KitFont {
  id        String   @id @default(cuid())
  role      String // display | heading | body | mono | accent
  weights   Int[]
  notes     String?
  createdAt DateTime @default(now())

  kitId  String
  kit    Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  fontId String
  font   Font   @relation(fields: [fontId], references: [id])

  @@unique([kitId, role])
  @@index([kitId])
  @@map("kit_fonts")
}

model TypeScale {
  id         String @id @default(cuid())
  name       String @default("Default")
  baseSize   Float  @default(16)
  ratio      Float  @default(1.25)
  stepsUp    Int    @default(5)
  stepsDown  Int    @default(2)
  rounding   Float  @default(1)

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  steps ScaleStep[]

  @@index([kitId])
  @@map("type_scales")
}

// Steps are materialised rather than recomputed on read: a step can be
// overridden by hand, and an export has to be reproducible from the record.
model ScaleStep {
  id            String @id @default(cuid())
  step          Int
  name          String
  px            Float
  lineHeight    Float
  letterSpacing Float  @default(0)

  kitId   String // denormalised: every child carries kitId
  scaleId String
  scale   TypeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, step])
  @@index([kitId])
  @@map("scale_steps")
}

model Palette {
  id      String @id @default(cuid())
  name    String @default("Default")
  harmony String @default("monochrome")

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  swatches Swatch[]

  @@index([kitId])
  @@map("palettes")
}

model Swatch {
  id     String  @id @default(cuid())
  role   String // primary | secondary | accent | neutral | surface | …
  hex    String
  // OKLCH stored alongside hex: the ramp maths works in OKLCH, and round-tripping
  // through hex loses precision on every edit.
  l      Float
  c      Float
  h      Float
  locked Boolean @default(false)

  kitId     String
  paletteId String
  palette   Palette @relation(fields: [paletteId], references: [id], onDelete: Cascade)

  asForeground ContrastPair[] @relation("foreground")
  asBackground ContrastPair[] @relation("background")

  @@unique([paletteId, role])
  @@index([kitId])
  @@map("swatches")
}

// Materialised so a failing pair can be listed, sorted and gated on without
// recomputing the whole palette. This is the table the "change a colour ->
// revalidate every pair" query rewrites, in one transaction.
model ContrastPair {
  id        String   @id @default(cuid())
  ratio     Float
  passesAA  Boolean
  passesAAA Boolean
  level     String // AAA | AA | AA Large | Fail
  checkedAt DateTime @default(now())

  kitId String

  foregroundId String
  foreground   Swatch @relation("foreground", fields: [foregroundId], references: [id], onDelete: Cascade)
  backgroundId String
  background   Swatch @relation("background", fields: [backgroundId], references: [id], onDelete: Cascade)

  @@unique([foregroundId, backgroundId])
  @@index([kitId, passesAA])
  @@map("contrast_pairs")
}

model Board {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  items BoardItem[]

  @@index([kitId])
  @@map("boards")
}

model BoardItem {
  id        String   @id @default(cuid())
  sourceUrl String?
  imageUrl  String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  kitId   String
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  meta ExtractedMeta?

  @@index([kitId])
  @@map("board_items")
}

model ExtractedMeta {
  id            String   @id @default(cuid())
  dominantHexes String[]
  detectedFonts String[]
  extractedAt   DateTime @default(now())

  kitId  String
  itemId String    @unique
  item   BoardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([kitId])
  @@map("extracted_meta")
}

// Immutable snapshots. The whole Kit graph is serialised into `snapshot` so a
// version can be restored even after a font is delisted upstream.
model KitVersion {
  id        String   @id @default(cuid())
  version   Int
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@unique([kitId, version])
  @@index([kitId, createdAt])
  @@map("kit_versions")
}

// --- async ---------------------------------------------------------------

model ExportJob {
  id          String    @id @default(cuid())
  format      String // css | tailwind | tokens | pdf | zip
  status      String    @default("queued") // queued | running | done | failed
  artefactUrl String?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  kitId String
  kit   Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, createdAt])
  @@map("export_jobs")
}

// Uploaded identification images. Purged after 30 days unless saved to a Kit —
// a GDPR requirement, enforced by a scheduled job reading expiresAt.
model IdentifyRequest {
  id         String    @id @default(cuid())
  mode       String // url | image
  inputUrl   String?
  imageUrl   String?
  results    Json
  savedToKit Boolean   @default(false)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([expiresAt])
  @@map("identify_requests")
}

// =========================================================================
// COMMUNITY
//
// Post a project, save other people's work into collections, follow the
// creators, message them. The social layer sits alongside the tools rather
// than inside them: a Project references the fonts and colours it used, which
// is what makes the feed useful to a designer rather than just pretty.
// =========================================================================

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(2000)
  // Free-text credit for work the poster did not make themselves. Posting
  // someone else's work is allowed; claiming it is not.
  sourceUrl   String?
  sourceCredit String? @db.VarChar(200)

  // Denormalised counters. Feed sorting reads these on every row; counting
  // likes across a join per row is the query that kills a feed at scale.
  likeCount Int @default(0)
  saveCount Int @default(0)
  viewCount Int @default(0)

  status      ProjectStatus @default(PUBLISHED)
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  images   ProjectImage[]
  fonts    ProjectFont[]
  colours  ProjectColour[]
  tags     ProjectTag[]
  likes    Like[]
  saves    Save[]
  reports  Report[]

  @@index([status, publishedAt])
  @@index([authorId, publishedAt])
  @@index([likeCount])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  // Hidden by a moderator. Kept rather than deleted so a report has something
  // to point at and an appeal has something to restore.
  REMOVED
}

model ProjectImage {
  id       String  @id @default(cuid())
  url      String
  // Vercel Blob pathname. Needed to delete the object when the row goes.
  blobPath String
  alt      String? @db.VarChar(200)
  width    Int
  height   Int
  bytes    Int
  position Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_images")
}

// The bridge back to the tools: "set in Fraunces and Inter" is a link, not a
// caption. A font here may not exist in the catalogue (commercial faces), so
// this stores the name and an optional slug rather than a foreign key.
model ProjectFont {
  id       String  @id @default(cuid())
  family   String
  fontSlug String?
  role     String? // display | heading | body | mono

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fontSlug])
  @@map("project_fonts")
}

model ProjectColour {
  id       String @id @default(cuid())
  hex      String @db.VarChar(9)
  position Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_colours")
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  label String

  projects ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("likes")
}

// --- collections ---------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  slug        String
  description String?  @db.VarChar(500)
  isPrivate   Boolean  @default(false)
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  saves Save[]

  @@unique([ownerId, slug])
  @@index([ownerId, updatedAt])
  @@map("collections")
}

// A save is the join between a project and a collection. Uniqueness is on
// (collection, project) rather than (user, project): the same project can sit
// in two different boards, which is the whole point of boards.
model Save {
  id        String   @id @default(cuid())
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  userId       String
  projectId    String
  collectionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, projectId])
  @@index([userId, createdAt])
  @@index([projectId])
  @@map("saves")
}

// --- social graph --------------------------------------------------------

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId  String
  followingId String

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// --- messaging -----------------------------------------------------------
//
// Modelled as conversations with members rather than a flat sender/recipient
// pair. One-to-one is all the UI exposes today, but a group thread is the
// obvious next ask and retrofitting it onto a two-column table means a data
// migration on live message history.

model Conversation {
  id            String   @id @default(cuid())
  // Denormalised for the inbox list: ordering threads by their newest message
  // otherwise needs a correlated subquery per row.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id       String    @id @default(cuid())
  // Per-member read state, so "3 unread" is a comparison, not a scan.
  lastReadAt DateTime?
  // Leaving hides the thread for one member without destroying it for the other.
  leftAt     DateTime?

  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id        String   @id @default(cuid())
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())
  // Soft delete: the row stays so the thread keeps its shape.
  deletedAt DateTime?

  conversationId String
  senderId       String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- moderation ----------------------------------------------------------
//
// Blocks and reports exist from the first commit, not after the first
// incident. A public site with direct messaging needs both before it has
// users, because the day you need them is the day it is too late to build them.

model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blockedId String

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  detail     String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  resolution String?

  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // Exactly one target is set. Not split into separate tables because the
  // moderation queue reads all reports in one ordered list.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([status, createdAt])
  @@index([projectId])
  @@map("reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  STOLEN_WORK
  SEXUAL_CONTENT
  VIOLENCE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Abuse limiting for anything that writes on behalf of an anonymous or new
// account: uploads, messages, reports. Keyed by action + subject (user id or
// IP hash) with a rolling window.
model RateLimit {
  id         String   @id @default(cuid())
  key        String   @unique
  count      Int      @default(0)
  windowEnds DateTime

  @@index([windowEnds])
  @@map("rate_limits")
}
